# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Database
MONGO_URI=mongodb://localhost:27017/vieteats_ai

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change_this_super_secret_key
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary (upload ảnh/video)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI - OpenAI
OPENAI_API_KEY=sk-xxxxxxxx

# AI - Google Gemini
GEMINI_API_KEY=your_gemini_key

# Firebase Cloud Messaging (Push Notification)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_client_email
FIREBASE_PRIVATE_KEY=your_private_key

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Twilio (gửi OTP qua SMS thật - để trống sẽ log OTP ra console ở môi trường dev)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Seed accounts (chỉ dùng cho seed script)
SEED_ADMIN_EMAIL=admin@vieteats.ai
SEED_ADMIN_PASSWORD=Admin@123
SEED_USER_EMAIL=demo@vieteats.ai
SEED_USER_PASSWORD=Demo@123
